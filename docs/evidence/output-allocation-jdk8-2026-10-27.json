  "working_diff": "diff --git a/src/main/java/io/github/sandboxdemo/core/LimitedOutput.java b/src/main/java/io/github/sandboxdemo/core/LimitedOutput.java\nindex ff93da0..fc97880 100644\n--- a/src/main/java/io/github/sandboxdemo/core/LimitedOutput.java\n+++ b/src/main/java/io/github/sandboxdemo/core/LimitedOutput.java\n@@ -5,7 +5,6 @@ import java.io.IOException;\n import java.io.InputStream;\n import java.nio.charset.Charset;\n import java.nio.charset.StandardCharsets;\n-import java.util.Arrays;\n import java.util.function.Consumer;\n \n public final class LimitedOutput {\n@@ -93,7 +92,7 @@ public final class LimitedOutput {\n         }\n         int observed = mode == io.github.sandboxdemo.api.OutputCallbackMode.RAW ? count : allowed;\n         if (observed > 0) {\n-            callbacks.accept(Arrays.copyOf(buffer, observed));\n+            callbacks.accept(buffer, observed);\n         }\n     }\n \ndiff --git a/src/main/java/io/github/sandboxdemo/core/OutputCallbacks.java b/src/main/java/io/github/sandboxdemo/core/OutputCallbacks.java\nindex 2453a46..14b6cbb 100644\n--- a/src/main/java/io/github/sandboxdemo/core/OutputCallbacks.java\n+++ b/src/main/java/io/github/sandboxdemo/core/OutputCallbacks.java\n@@ -34,14 +34,23 @@ public final class OutputCallbacks {\n     }\n \n     public void accept(byte[] chunk) {\n-        if (chunk.length == 0) {\n+        accept(chunk, chunk.length);\n+    }\n+\n+    /** Consumes a borrowed prefix synchronously; only the user byte callback owns a copy. */\n+    void accept(byte[] chunk, int count) {\n+        if (count < 0 || count > chunk.length) {\n+            throw new IllegalArgumentException(\"invalid output chunk length\");\n+        }\n+        if (count == 0) {\n             return;\n         }\n         if (byteConsumer != null) {\n-            acceptIgnoringFailure(byteConsumer, Arrays.copyOf(chunk, chunk.length));\n+            acceptIgnoringFailure(byteConsumer, Arrays.copyOf(chunk, count));\n         }\n         if (textDecoder != null) {\n-            textDecoder.accept(chunk);\n+            // Both decoders consume/copy input before returning, never retain the borrowed array.\n+            textDecoder.accept(count == chunk.length ? chunk : Arrays.copyOf(chunk, count));\n         }\n     }\n \n",
